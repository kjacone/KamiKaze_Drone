# Multi-stage build for production
FROM kamikaze-drone-base:latest AS builder

# Copy source and build
COPY src/ /root/catkin_ws/src/
RUN cd /root/catkin_ws && \
    source /opt/ros/noetic/setup.bash && \
    catkin_make && \
    rm -rf /root/catkin_ws/build /root/catkin_ws/src

# Production image
FROM kamikaze-drone-base:latest

# Copy only built workspace
COPY --from=builder /root/catkin_ws /root/catkin_ws
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Clean up to reduce image size
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    find /usr -type f -name "*.pyc" -delete

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]