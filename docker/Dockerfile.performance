# Performance Monitor Service
FROM kamikaze-drone:latest AS base

# Install performance monitoring extras
RUN python3 -m pip install \
    --no-cache-dir \
    prometheus-client \
    prometheus-flask-exporter \
    psutil \
    gpustat \
    nvidia-ml-py3

# Create performance monitor user
RUN useradd -m -s /bin/bash perfmon && \
    mkdir -p /var/log/performance && \
    chown -R perfmon:perfmon /var/log/performance

# Copy performance monitor script
COPY drone_control/scripts/monitors/performance_monitor.py /opt/performance_monitor.py
RUN chmod +x /opt/performance_monitor.py

USER perfmon
WORKDIR /home/perfmon

CMD ["/bin/bash", "-c", "source /opt/ros/noetic/setup.bash && source /root/catkin_ws/devel/setup.bash && python3 /opt/performance_monitor.py"]