# syntax=docker/dockerfile:1.4

# ============================================================
# Performance Monitor Service
# ============================================================

FROM kamikaze-drone-python:latest

# Set platform to match your system
ARG TARGETPLATFORM=linux/amd64
ARG BUILDPLATFORM=linux/amd64

# ------------------------------------------------------------
# Copy application code LAST
#
# Changes to performance_monitor.py will only rebuild from here.
# All heavy dependencies remain cached.
# ------------------------------------------------------------

COPY --chmod=755 \
    drone_control/scripts/utils/performance_monitor.py \
    /opt/performance_monitor.py

# ------------------------------------------------------------
# Runtime user
# ------------------------------------------------------------

USER perfmon

WORKDIR /home/perfmon

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]

CMD ["python3", "/opt/performance_monitor.py"]