# Predictive Controller Service
FROM kamikaze-drone:latest AS base

# Install predictive control dependencies
RUN python3 -m pip install \
    --no-cache-dir \
    scikit-learn \
    pandas \
    numpy \
    scipy \
    matplotlib \
    seaborn \
    tensorflow-cpu \
    keras

# Copy predictive controller
COPY drone_control/scripts/controllers/predictive_controller.py /opt/predictive_controller.py
RUN chmod +x /opt/predictive_controller.py

# Create model directory
RUN mkdir -p /root/models/predictive
VOLUME /root/models/predictive

CMD ["/bin/bash", "-c", "source /opt/ros/noetic/setup.bash && source /root/catkin_ws/devel/setup.bash && python3 /opt/predictive_controller.py"]