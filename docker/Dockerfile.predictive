# syntax=docker/dockerfile:1.4

# ============================================================
# Predictive Controller Service
# ============================================================

FROM kamikaze-drone-predictive:latest

# Set platform to match your system
ARG TARGETPLATFORM=linux/amd64
ARG BUILDPLATFORM=linux/amd64





# ------------------------------------------------------------
# Copy application code LAST
# ------------------------------------------------------------

COPY --chmod=755 \
    drone_control/scripts/controllers/predictive_controller.py \
    /opt/predictive_controller.py

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

WORKDIR /opt

ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]

CMD ["python3", "/opt/predictive_controller.py"]