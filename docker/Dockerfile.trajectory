# syntax=docker/dockerfile:1.4

# ============================================================
# Trajectory Planner Service
# ============================================================

FROM kamikaze-drone-python:latest

# Set platform to match your system
ARG TARGETPLATFORM=linux/amd64
ARG BUILDPLATFORM=linux/amd64
# ------------------------------------------------------------
# Copy application code LAST
# ------------------------------------------------------------

COPY --chmod=755 \
    drone_control/scripts/controllers/trajectory_planner.py \
    /opt/trajectory_planner.py

# ------------------------------------------------------------
# Verify ROS messages
#
# This is intentionally lightweight and happens after the
# shared dependency image has already been built.
# ------------------------------------------------------------

RUN /bin/bash -c "\
    source /opt/ros/noetic/setup.bash && \
    source /root/catkin_ws/devel/setup.bash 2>/dev/null || true && \
    echo 'Checking for drone_control messages...' && \
    find /root/catkin_ws/devel -name '*TrackedTarget*' -type f || true"

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

WORKDIR /opt

ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]

CMD ["python3", "/opt/trajectory_planner.py"]