# Trajectory Planner Service
FROM kamikaze-drone:latest AS base

# Install trajectory planning dependencies
RUN python3 -m pip install \
    --no-cache-dir \
    shapely \
    rtree \
    scipy \
    numpy \
    matplotlib \
    networkx \
    pyastar \
    pathfinding

# Copy trajectory planner
COPY drone_control/scripts/planners/trajectory_planner.py /opt/trajectory_planner.py
RUN chmod +x /opt/trajectory_planner.py

# Create trajectory cache
RUN mkdir -p /var/cache/trajectories
VOLUME /var/cache/trajectories

CMD ["/bin/bash", "-c", "source /opt/ros/noetic/setup.bash && source /root/catkin_ws/devel/setup.bash && python3 /opt/trajectory_planner.py"]