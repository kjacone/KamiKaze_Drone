<?xml version="1.0"?>
<launch>
  <!-- ============================================ -->
  <!-- UNIFIED LAUNCH CONFIGURATION FOR DRONE CONTROL -->
  <!-- ============================================ -->

  <!-- === LAUNCH MODE SELECTION === -->
  <arg name="mode" default="production" doc="Launch mode: production, test, or debug"/>
  <arg name="simulation" default="true" doc="Use simulation (true) or real hardware (false)"/>
  <arg name="enable_safety" default="true" doc="Enable safety verification nodes"/>
  <arg name="enable_diagnostics" default="false" doc="Enable diagnostic tools"/>
  <arg name="gui" default="false" doc="Enable GUI visualization"/>
  <arg name="validate_params" default="true" doc="Validate parameters on startup"/>
  <arg name="perception_demo" default="false" doc="Run the camera/YOLO pipeline instead of the simulated target (ground-only smoke test)"/>
  <arg name="auto_start" default="true" doc="Start a mission automatically once MAVROS is connected"/>

  <!-- === TEST MODE SPECIFIC ARGUMENTS === -->
  <arg name="test_scenario" default="default" doc="Test scenario to run"/>
  <arg name="test_timeout" default="120" doc="Test timeout in seconds"/>

  <!-- === DEBUG MODE SPECIFIC ARGUMENTS === -->
  <arg name="debug_level" default="debug" doc="Debug level"/>
  <arg name="enable_profiling" default="true" doc="Enable performance profiling"/>

  <!-- === PARAMETER LOADING === -->
  <rosparam file="$(find drone_control)/config/target_params.yaml" command="load"/>
  <rosparam file="$(find drone_control)/config/camera_calib.yaml" command="load" ns="camera_calib"/>
  <rosparam file="$(find drone_control)/config/flight_control.yaml" command="load"/>
  <rosparam file="$(find drone_control)/config/kalman_filter.yaml" command="load" ns="kalman_filter"/>
  <rosparam file="$(find drone_control)/config/system_params.yaml" command="load"/>

  <!-- === SIMULATION VS REAL HARDWARE === -->
  <param name="/use_simulation" value="$(arg simulation)"/>

  <!-- ============================================ -->
  <!-- MAVROS                                       -->
  <!-- ============================================ -->

  <node pkg="mavros" type="mavros_node" name="mavros"
        output="screen" respawn="true" respawn_delay="2.0">
    <rosparam file="$(find drone_control)/config/mavros.yaml" command="load"/>
  </node>

  <!-- ============================================ -->
  <!-- CORE SYSTEM NODES                            -->
  <!-- ============================================ -->

  <!-- Command Interpreter -->
  <node pkg="drone_control" type="command_interpreter.py"
        name="command_interpreter" output="screen" />

  <!-- Mission Manager -->
  <node pkg="drone_control" type="mission_manager.py"
        name="mission_manager" output="screen" >
    <param name="mission_config" value="$(find drone_control)/config/mission_config.yaml"/>
    <param name="auto_start" value="$(arg auto_start)"/>
    <param name="require_mavros" value="true"/>
    <param name="target_timeout" value="2.0"/>
  </node>

  <!-- ============================================ -->
  <!-- TARGET SOURCE                                -->
  <!-- ============================================ -->

  <!-- Real perception pipeline: ground-only smoke test until pixel-to-world
       projection exists. Not a flight-capable target source. -->
  <group if="$(arg perception_demo)">
    <node pkg="drone_control" type="synthetic_camera.py"
          name="synthetic_camera" output="screen" >
      <param name="width" value="640"/>
      <param name="height" value="480"/>
      <param name="rate" value="10.0"/>
    </node>

    <node pkg="drone_control" type="camera_calibration.py"
          name="camera_calibration" output="screen" >
      <param name="simulation_mode" value="$(arg simulation)"/>
    </node>

    <node pkg="drone_control" type="yolo_detector.py"
          name="yolo_detector" output="screen" >
      <param name="model_path" value="/PX4-Autopilot/yolov8s.pt"/>
      <param name="device" value="cpu"/>
    </node>

    <node pkg="drone_control" type="sensor_fusion.py"
          name="sensor_fusion" output="screen" >
      <param name="publish_rate" value="20"/>
      <param name="simulation_mode" value="$(arg simulation)"/>
    </node>

    <node pkg="drone_control" type="target_tracking_controller.py"
          name="target_tracking_controller" output="screen" >
      <param name="simulation_mode" value="$(arg simulation)"/>
    </node>
  </group>

  <!-- Demoed target source and the single control owner. -->
  <group unless="$(arg perception_demo)">
    <node pkg="drone_control" type="simulated_target.py"
          name="simulated_target" output="screen" >
      <param name="scenario" value="default"/>
    </node>

    <node pkg="drone_control" type="target_follower.py"
          name="target_follower" output="screen" >
      <param name="target_timeout" value="2.0"/>
    </node>
  </group>

  <!-- ============================================ -->
  <!-- VEHICLE MONITORING                           -->
  <!-- ============================================ -->

  <node pkg="drone_control" type="vehicle_state_monitor.py"
        name="vehicle_state_monitor" output="screen" >
    <param name="simulation_mode" value="$(arg simulation)"/>
  </node>

  <!-- ============================================ -->
  <!-- SAFETY NODES                                -->
  <!-- ============================================ -->

  <group if="$(arg enable_safety)">
    <node pkg="drone_control" type="safety_monitor.py"
          name="safety_monitor" output="screen" >
      <param name="simulation_mode" value="$(arg simulation)"/>
    </node>
  </group>

  <!-- ============================================ -->
  <!-- HEALTH MONITORING                           -->
  <!-- ============================================ -->

  <node pkg="drone_control" type="system_health_monitor.py"
        name="system_health_monitor" output="screen" >
    <param name="monitoring_interval" value="2.0"/>
    <param name="critical_threshold_cpu" value="90.0"/>
    <param name="critical_threshold_memory" value="90.0"/>
    <param name="warning_threshold_cpu" value="70.0"/>
    <param name="warning_threshold_memory" value="70.0"/>
    <param name="enable_network_monitoring" value="true"/>
    <param name="enable_disk_monitoring" value="true"/>
    <param name="enable_process_monitoring" value="true"/>
  </node>

  <!-- Never restart controllers: a restart during an emergency would wipe
       the latched safety state. -->
  <node pkg="drone_control" type="health_checker.py"
        name="health_checker" output="screen" >
    <param name="check_interval" value="5.0"/>
    <param name="timeout_threshold" value="10.0"/>
    <param name="restart_on_failure" value="false"/>
    <param name="max_restarts" value="0"/>

    <rosparam param="monitored_nodes">
      ['vehicle_state_monitor', 'mission_manager',
       'safety_monitor', 'command_interpreter']
    </rosparam>
  </node>

  <!-- ============================================ -->
  <!-- VISUALIZATION (GUI)                         -->
  <!-- ============================================ -->

  <group if="$(arg gui)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find drone_control)/config/drone_control.rviz"
          output="screen" />
  </group>

</launch>
