Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /TF1
        - /Camera Image1
        - /Target Markers1
      Splitter Ratio: 0.5
    Tree Height: 582
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
  - Class: rviz/Views
    Name: Views
    Expanded:
      - /Current View1
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Camera Image

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: map
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        camera_color_frame:
          Value: true
        camera_depth_frame:
          Value: true
        camera_link:
          Value: true
        camera_optical_frame:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            base_link:
              camera_link:
                camera_color_frame:
                  {}
                camera_depth_frame:
                  {}
                camera_optical_frame:
                  {}
              camera_color_frame:
                {}
              camera_depth_frame:
                {}
              camera_optical_frame:
                {}
      Update Interval: 0
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/color/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera Image
      Normalize Range: true
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /drone_control/target_markers
      Name: Target Markers
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Name: Target Bounding Box
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: Drone Trajectory
      Topic: /drone_control/trajectory
      Value: true
    - Class: rviz/PoseArray
      Enabled: true
      Name: Drone Position History
      Topic: /drone_control/position_history
      Value: true
    - Class: rviz/RobotModel
      Enabled: false
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz/Map
      Enabled: false
      Name: Map
      Topic: /map
      Value: false
    - Class: rviz/InteractiveMarkers
      Enabled: false
      Name: Interactive Markers
      Update Topic: /move_base/feedback
    - Class: rviz/Camera
      Enabled: false
      Name: Camera View
      Zoom Factor: 1
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light:
      Ambient Light Color: 255; 255; 255
      Directional Light Color: 255; 255; 255
      Directional Light Pitch: 0.7853981633974483
      Directional Light Yaw: 0.7853981633974483
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.059999999999999998
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.050000000000000003
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.0099999999999999985
      Pitch: 0.78539816339744828
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.78539816339744828
    Saved: ~

Window Geometry:
  Camera Image:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1024
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Width: 1280
  X: 50
  Y: 50